NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://your-app.vercel.app  (no trailing slash)
APP_URL=http://localhost:3000
# Bearer key Claude uses for /api/mcp, and the user it acts as. Generate: openssl rand -hex 32
MCP_API_KEY=
MCP_USER_ID=
# Protects /api/sync when called by a scheduler. Generate: openssl rand -hex 32
CRON_SECRET=
