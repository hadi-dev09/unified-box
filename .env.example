NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack app (see CHECKLIST.md). Leave empty to hide the Slack button.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# e.g. https://your-app.vercel.app  (no trailing slash)
APP_URL=http://localhost:3000
# Protects /api/sync when called by a scheduler. Generate: openssl rand -hex 32
CRON_SECRET=
# Outlook / Microsoft 365 (Azure app registration, see docs/CONNECTORS.md). Leave empty to show "Coming soon".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# WhatsApp Business Cloud API (Meta app, see docs/CONNECTORS.md)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook settings. Generate: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=
# Telegram (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
